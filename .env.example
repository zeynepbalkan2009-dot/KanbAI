APP_ENV=development
APP_NAME="QC Industrial Platform"
APP_VERSION=0.1.0
DEBUG=true

# â”€â”€ Backend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# â”€â”€ JWT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
JWT_REFRESH_SECRET_KEY=change-me-refresh-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qcplatform
POSTGRES_USER=qcuser
POSTGRES_PASSWORD=qcpassword123
DATABASE_URL=postgresql+asyncpg://qcuser:qcpassword123@postgres:5432/qcplatform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# â”€â”€ Redis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123
REDIS_URL=redis://:redispassword123@redis:6379/0
REDIS_CELERY_DB=1
CELERY_BROKER_URL=redis://:redispassword123@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword123@redis:6379/2

# â”€â”€ MinIO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_INSPECTIONS=inspections
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATASETS=datasets
MINIO_SECURE=false

# â”€â”€ AI / Inference â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
AI_INFERENCE_MODE=mock
AI_MOCK_DELAY_MIN=2.0
AI_MOCK_DELAY_MAX=4.0
AI_CONFIDENCE_PASS_THRESHOLD=0.75
AI_CONFIDENCE_REVIEW_THRESHOLD=0.50
YOLO_MODEL_PATH=models/best.pt
ONNX_MODEL_PATH=models/best.onnx

# â”€â”€ Celery â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# â”€â”€ Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOG_LEVEL=INFO
LOG_FORMAT=json

# â”€â”€ Next.js web â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# â”€â”€ MLOps â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=qc_defect_detection
RETRAIN_THRESHOLD=200
DRIFT_THRESHOLD=0.15
SLACK_WEBHOOK_URL=

# â”€â”€ Demo â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DEMO_MODE=true
DEMO_FACTORY_ID=f0000000-0000-0000-0000-000000000001
