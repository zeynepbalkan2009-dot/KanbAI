# App
# Local demo defaults only. Rotate every secret before a factory pilot or any
# internet-facing deployment.
APP_ENV=development
APP_NAME="KanbAI QC Platform"
APP_VERSION=0.1.0
DEBUG=true

# Backend
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:19006

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
JWT_REFRESH_SECRET_KEY=change-me-refresh-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qcplatform
POSTGRES_USER=qcuser
POSTGRES_PASSWORD=kanbai-local-demo-postgres
DATABASE_URL=postgresql+asyncpg://qcuser:kanbai-local-demo-postgres@postgres:5432/qcplatform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kanbai-local-demo-redis
REDIS_URL=redis://:kanbai-local-demo-redis@redis:6379/0
REDIS_CELERY_DB=1
CELERY_BROKER_URL=redis://:kanbai-local-demo-redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:kanbai-local-demo-redis@redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=kanbai-local-demo-minio
MINIO_BUCKET_INSPECTIONS=inspections
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATASETS=datasets
MINIO_SECURE=false

# AI / Inference
# Options:
# - mock: stable presentation and data-collection mode
# - pilot_yolo_scope: YOLO checks whether the image is in the pilot part family,
#   then routes quality decisions through HITL while factory labels are collected
# - yolo: direct YOLO defect inference with an approved factory-trained model
# - onnx: ONNX runtime inference
AI_INFERENCE_MODE=mock
AI_MOCK_DELAY_MIN=2.0
AI_MOCK_DELAY_MAX=4.0
AI_CONFIDENCE_PASS_THRESHOLD=0.75
AI_CONFIDENCE_REVIEW_THRESHOLD=0.50
YOLO_MODEL_PATH=/app/models/best.pt
ONNX_MODEL_PATH=models/best.onnx

# Celery
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Next.js web
# Leave empty to use same-origin API/WebSocket via nginx.
# Set only when intentionally bypassing nginx in local development.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# MLOps
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=qc_defect_detection
RETRAIN_THRESHOLD=200
DRIFT_THRESHOLD=0.15
SLACK_WEBHOOK_URL=

# Demo
DEMO_MODE=true
DEMO_FACTORY_ID=f0000000-0000-0000-0000-000000000001

# Secure Edge / Cloud controls
# Edge sync is authenticated with per-device credentials. Raw credentials are never
# persisted; only a hash is stored in PostgreSQL.
EDGE_DEVICE_AUTH_ENABLED=true
EDGE_SYNC_ENABLED=true
EDGE_SYNC_BATCH_MAX=100
EDGE_EVENT_MAX_PAYLOAD_BYTES=262144
EDGE_TOKEN_CLOCK_SKEW_SECONDS=60
EDGE_REQUIRE_SIGNED_MODEL=true

# Factory pilot safety controls
# Set to true for a real-factory pilot. This disables automatic demo seeding and
# the /api/v1/mlops/demo/reset and /api/v1/mlops/demo/seed endpoints, even if
# DEMO_MODE is also true. Keep false for demo/presentation environments.
PILOT_MODE=false

# Secure model deployment (fail-closed when signed models are required)
MODEL_SIGNING_SECRET=
MODEL_VALIDATION_MIN_MAP50=0.80
MODEL_VALIDATION_MIN_PRECISION=0.80
MODEL_VALIDATION_MIN_RECALL=0.80
